# GEMINI_API_KEY: Required for server-side Gemini AI structured assessment planning.
# AI Studio automatically injects this at runtime from user secrets (Settings > Secrets).
# Never expose this key to client-side code.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Base HTTPS URL where Sentinel AI is hosted.
APP_URL="https://sentinel-ai.internal"

# SENTINEL_SESSION_SECRET: Server-side secret used to sign operator session tokens.
SENTINEL_SESSION_SECRET="replace-with-32-byte-random-hex-secret"

# SENTINEL_DATA_DIR: Directory path for persistent JSON/SQLite state storage.
SENTINEL_DATA_DIR="./data"

# SENTINEL_DEFAULT_RATE_LIMIT_RPM: Maximum allowed requests per minute for passive HTTP checks.
SENTINEL_DEFAULT_RATE_LIMIT_RPM="30"
